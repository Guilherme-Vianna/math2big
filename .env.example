# Copie para .env e preencha
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# MATH2BIG_MODEL=gemini-3.8-flash

# Banco Postgres (ex.: Neon) — registra conversões, tokens e uso. Opcional.
DATABASE_URL=

# Painel /admin. Sem ADMIN_PASSWORD o painel fica desativado.
ADMIN_PASSWORD=
# Chave para assinar a sessão do painel (gere uma longa e aleatória).
ADMIN_SECRET=
